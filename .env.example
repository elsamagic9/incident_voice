# AssemblyAI is required for microphone transcription and LeMUR generation.
# Blank credentials enable explicitly labeled text-only/local fallback behavior.
ASSEMBLYAI_API_KEY=

# Custom-engine reasoning: gemini, openai, or mock (scripted commands).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Custom-engine speech: edge-tts or browser.
TTS_PROVIDER=edge-tts

# simulation, docker, or kubernetes. Live modes require an operator token.
INFRASTRUCTURE_MODE=simulation
OPERATOR_ACCESS_TOKEN=
KUBERNETES_NAMESPACE=production
COOKIE_SECURE=false

HOST=0.0.0.0
PORT=8000
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
