# ==========================================
# IncidentVoice: Environment Configuration
# AssemblyAI Voice Agent Hackathon (lablab.ai)
# ==========================================

# AssemblyAI Credentials (REQUIRED)
# Get your API key at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# LLM Provider for Agent Orchestration
# Options: "gemini", "openai", "claude", or "mock" (for offline demo testing)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# TTS Provider for Low-Latency Spoken Responses
# Options: "cartesia", "elevenlabs", "edge-tts", or "browser" (free, client-side Web Speech fallback)
TTS_PROVIDER=edge-tts
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
