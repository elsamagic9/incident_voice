# AssemblyAI is required for microphone transcription and LLM Gateway generation.
# Blank credentials enable explicitly labeled text-only/local fallback behavior.
ASSEMBLYAI_API_KEY=

# Custom-engine reasoning: poolside, gemini, openai, assemblyai, or mock (scripted commands).
LLM_PROVIDER=poolside
POOLSIDE_API_KEY=
POOLSIDE_BASE_URL=https://inference.poolside.ai/v1
POOLSIDE_MODEL=poolside/laguna-s-2.1
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-4o-mini
LLM_GATEWAY_MODEL=qwen3.5-4b-32k-fast
DEFAULT_ENGINE=voice_agent_api
VOICE_AGENT_VOICE=george

# Custom-engine speech: edge-tts or browser.
TTS_PROVIDER=edge-tts

# simulation, docker, or kubernetes. Live modes require an operator token.
INFRASTRUCTURE_MODE=simulation
OPERATOR_ACCESS_TOKEN=
# Pre-configured Multi-Operator Tokens for testing/pilot:
# Commander: token-commander-sarah (Sarah Chen, Principal SRE - Full mutation authority)
# Responder: token-responder-alex  (Alex Rivera, On-Call SRE - Diagnostics & Runbooks)
# Observer:  token-observer-jordan (Jordan Lee, Security Auditor - Read-only oversight)
WAL_STORAGE_DIR=data
KUBERNETES_NAMESPACE=production
COOKIE_SECURE=false

HOST=0.0.0.0
PORT=8000
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

